# Providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Infra
DATABASE_URL=
REDIS_URL=
DISCORD_WEBHOOK_URL=

# App
PORT=3000
STAGE_SLA_STT_MS=5000
STAGE_SLA_LLM_MS=8000
STAGE_SLA_TTS_MS=5000
# Uploaded / recorded audio limit (bytes) and per-user daily analysis quota
MAX_UPLOAD_BYTES=5242880
MAX_CALLS_PER_WORKSPACE_PER_DAY=25

# Budget caps (USD) — refuse new /calls past these
SESSION_COST_CAP_USD=1.00
DAILY_COST_CAP_USD=5.00

# Postgres pool tuning
PG_POOL_MAX=12

# Audio storage driver: "fs" (default, local disk — wiped on redeploy)
#                       "s3" (S3-compatible: R2, Backblaze, MinIO, real S3)
STORAGE_DRIVER=fs
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
