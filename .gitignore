# Backend runtime storage — per-call audio blobs
backend/storage/
# Bundled demo calls (backend/samples/*.wav) ARE committed so a fresh deploy has audio.
# Ignore locally generated mp3/ogg (e.g. from `npm run seed-samples`).
backend/samples/*.mp3
backend/samples/*.ogg
!backend/samples/README.md

# Package manager backups
package-lock.json.bak
yarn.lock.bak

# Scratch
scratch/
tmp/
*.tmp

# Secrets safeguard — never commit anything that looks like a key
*.pem
*.key
secrets/
